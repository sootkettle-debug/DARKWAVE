    <GradientStop Color="#7E8B92" Offset="0.72"/>
    <GradientStop Color="#C8D2D6" Offset="0.90"/>
    <GradientStop Color="#00000000" Offset="1.00"/>
   </LinearGradientBrush>
  </TextBlock.Foreground>
 </TextBlock>
 </Grid>
 <Grid x:Name="LogoPlusMark" VerticalAlignment="Center" Margin="4,0,0,0">
 <TextBlock Text="+" FontFamily="pack://application:,,,/Fonts/#Pirata One" FontSize="58" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Top">
