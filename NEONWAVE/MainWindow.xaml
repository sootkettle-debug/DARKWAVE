 <Grid VerticalAlignment="Center">
 <TextBlock Text="DARKWAVE" FontFamily="pack://application:,,,/Fonts/#Pirata One" FontSize="79.2" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Top">
  <TextBlock.Foreground>
   <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#A7B1B6" Offset="0.00"/>
    <GradientStop Color="#5C666C" Offset="0.08"/>
    <GradientStop Color="#1D2327" Offset="0.18"/>
    <GradientStop Color="#060809" Offset="0.40"/>
    <GradientStop Color="#111518" Offset="0.68"/>
    <GradientStop Color="#000000" Offset="1.00"/>
   </LinearGradientBrush>
  </TextBlock.Foreground>
  <TextBlock.Effect><DropShadowEffect BlurRadius="7" ShadowDepth="1" Opacity="0.45" Color="#000000"/></TextBlock.Effect>
 </TextBlock>
 <!-- Polished-glass highlight, fading into the black surface. -->
 <TextBlock Text="DARKWAVE" FontFamily="pack://application:,,,/Fonts/#Pirata One" FontSize="79.2" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.22" Margin="0,-1,0,0">
  <TextBlock.Foreground>
   <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0.00"/>
    <GradientStop Color="#D9E2E6" Offset="0.10"/>
    <GradientStop Color="#80FFFFFF" Offset="0.18"/>
    <GradientStop Color="#00FFFFFF" Offset="0.34"/>
    <GradientStop Color="#00FFFFFF" Offset="1.00"/>
   </LinearGradientBrush>
  </TextBlock.Foreground>
 </TextBlock>
