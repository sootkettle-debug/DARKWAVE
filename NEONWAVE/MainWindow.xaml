<Window x:Class="NEONWAVE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Compact Dark — DARKWAVE+" Width="760" Height="690" MinWidth="744" MinHeight="580"
 Background="#08090A" Foreground="#DDE5E5" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver"
 KeyDown="Window_KeyDown">
 <Window.Resources>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#0B0E11"/><Setter Property="Foreground" Value="#D5DEDF"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,9"/><Setter Property="Margin" Value="0,2"/><Setter Property="Background" Value="#171B1F"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Style.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#30383D"/><Setter Property="Foreground" Value="#D5E5D8"/></Trigger></Style.Triggers></Style>
  <Style TargetType="ScrollBar">
   <Setter Property="Width" Value="13"/><Setter Property="Background" Value="#090A0B"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Grid Background="#090A0B" Width="13">
     <Border Margin="3,2" CornerRadius="0" Background="#11171A" BorderBrush="#303B40" BorderThickness="1"/>
     <Track x:Name="PART_Track" IsDirectionReversed="True">
      <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Margin="1,1" CornerRadius="0" BorderBrush="#A8B9B2" BorderThickness="1"><Border.Effect><DropShadowEffect Color="#84978E" BlurRadius="9" ShadowDepth="0" Opacity="0.9"/></Border.Effect><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#151C1E" Offset="0"/><GradientStop Color="#263238" Offset="0.5"/><GradientStop Color="#1B2528" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="#263238"/><Setter Property="Background" Value="#11171A"/><Setter Property="Height" Value="20"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid VerticalAlignment="Center" Height="20"><Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False" Height="5" VerticalAlignment="Center" Background="#263238" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="13" Height="13" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#1B2528" BorderBrush="#A8B9B2" BorderThickness="1" CornerRadius="0"><Border.Effect><DropShadowEffect Color="#84978E" BlurRadius="8" ShadowDepth="0" Opacity="0.95"/></Border.Effect></Border></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False" Height="5" VerticalAlignment="Center" Background="#11171A" BorderThickness="0"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="{TemplateBinding Background}" CornerRadius="0"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <!-- Glossy seek track: black glass for unplayed audio; live accent brush for played portion. -->
  <Style x:Key="GlossySeekSliderStyle" TargetType="Slider">
   <Setter Property="Height" Value="20"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Slider">
      <Grid Height="20" VerticalAlignment="Center">
       <Track x:Name="PART_Track" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
        <Track.DecreaseRepeatButton>
         <RepeatButton Command="Slider.DecreaseLarge" IsTabStop="False" Focusable="False" Height="6" VerticalAlignment="Center">
          <RepeatButton.Template>
           <ControlTemplate TargetType="RepeatButton">
            <Grid>
             <Border CornerRadius="3" Background="{DynamicResource AccentBrush}"/>
             <Border CornerRadius="3" BorderBrush="#80FFFFFF" BorderThickness="0,1,0,0" Opacity="0.35">
              <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#AAFFFFFF" Offset="0"/><GradientStop Color="#00FFFFFF" Offset="0.5"/><GradientStop Color="#55000000" Offset="1"/></LinearGradientBrush></Border.Background>
             </Border>
            </Grid>
           </ControlTemplate>
          </RepeatButton.Template>
         </RepeatButton>
        </Track.DecreaseRepeatButton>
        <Track.Thumb>
         <Thumb Width="10.5" Height="10.5" Focusable="False">
          <Thumb.Template>
           <ControlTemplate TargetType="Thumb">
            <Ellipse Stroke="#849499" StrokeThickness="1">
             <Ellipse.Fill><RadialGradientBrush Center="0.3,0.2" GradientOrigin="0.3,0.2"><GradientStop Color="#576267" Offset="0"/><GradientStop Color="#252C30" Offset="0.3"/><GradientStop Color="#06090B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
             <Ellipse.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="1" Opacity="0.8"/></Ellipse.Effect>
            </Ellipse>
           </ControlTemplate>
          </Thumb.Template>
         </Thumb>
        </Track.Thumb>
        <Track.IncreaseRepeatButton>
         <RepeatButton Command="Slider.IncreaseLarge" IsTabStop="False" Focusable="False" Height="6" VerticalAlignment="Center">
          <RepeatButton.Template>
           <ControlTemplate TargetType="RepeatButton">
            <Border CornerRadius="3" BorderBrush="#526065" BorderThickness="0,1,0,1">
             <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#465156" Offset="0"/><GradientStop Color="#20292D" Offset="0.23"/><GradientStop Color="#070A0C" Offset="0.64"/><GradientStop Color="#151B1E" Offset="1"/></LinearGradientBrush></Border.Background>
            </Border>
           </ControlTemplate>
          </RepeatButton.Template>
         </RepeatButton>
        </Track.IncreaseRepeatButton>
       </Track>
      </Grid>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/><Setter Property="Background" Value="#252C2F"/><Setter Property="BorderBrush" Value="#765B40"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="5.25,4.5"/><Setter Property="FontSize" Value="7.5"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="Margin" Value="2.25,0"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Grid><Border x:Name="Face" CornerRadius="7" BorderThickness="1" BorderBrush="#765B40"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#4C463E" Offset="0"/><GradientStop Color="#332F2C" Offset="0.18"/><GradientStop Color="#151B1E" Offset="0.52"/><GradientStop Color="#302D29" Offset="1"/></LinearGradientBrush></Border.Background><Border.Effect><DropShadowEffect Color="#000000" BlurRadius="5" ShadowDepth="2" Opacity="0.85"/></Border.Effect></Border><Border Margin="1.5" CornerRadius="5.5" BorderThickness="1" BorderBrush="#263034" IsHitTestVisible="False"/><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" Margin="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}" RecognizesAccessKey="True"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#C4D0C9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.78"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Grid Margin="10,10,10,9">
  <Grid.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#302B27" Offset="0"/><GradientStop Color="#151515" Offset="0.12"/><GradientStop Color="#080B0D" Offset="1"/></LinearGradientBrush></Grid.Background>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition x:Name="LibraryRow" Height="*"/></Grid.RowDefinitions>
  <Border x:Name="LogoGlow" Visibility="Collapsed" Width="0" Height="0"/>
  <Border x:Name="UpperPaneBorder" Grid.Row="0" Background="#1B2023" BorderBrush="#5C5B54" BorderThickness="1" CornerRadius="4" Padding="9,2,9,5" Margin="0,0,0,7"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid x:Name="UpperHeaderGrid" Grid.Row="0" SizeChanged="UpperHeaderGrid_SizeChanged">
<Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="94"/></Grid.ColumnDefinitions>
<StackPanel Grid.Column="0" Grid.ColumnSpan="2">
<Grid Height="72"/>
<!-- Position glass panel 10px beneath the album artwork (art bottom at 87px, glass top at 97px); the time row begins 10px after the glass panel. -->
<Border x:Name="TrackGlassPanel" HorizontalAlignment="Stretch" Height="25.5" Margin="0,25,0,0" Padding="10,2,10,2"
        CornerRadius="7" BorderBrush="#59666B" BorderThickness="1">
 <Border.Background>
  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#3A464B" Offset="0"/>
   <GradientStop Color="#192125" Offset="0.16"/>
   <GradientStop Color="#05080A" Offset="0.62"/>
   <GradientStop Color="#141C20" Offset="1"/>
  </LinearGradientBrush>
 </Border.Background>
 <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="8" ShadowDepth="2" Opacity="0.8"/></Border.Effect>
 <!-- Fit the entire title by reducing its rendered size, never enlarging short titles. -->
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Stretch" VerticalAlignment="Center">
  <TextBlock x:Name="TrackTitle" Text="NO TRACK LOADED" Foreground="{DynamicResource AccentBrush}"
             FontFamily="/Fonts/#DSEG14 Classic" FontStyle="Italic" FontSize="18" FontWeight="Normal"
             TextWrapping="NoWrap"/>
 </Viewbox>
</Border>
</StackPanel>
<!-- Album art only. The former centred position left roughly 22px of top space;
     retaining 40% of that space moves the artwork up by about 60%. -->
<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,9,0,0">
 <Border x:Name="AlbumArtScreen" Width="78" Height="78" CornerRadius="3" Background="#0B1011" BorderBrush="#FFA43A" BorderThickness="1"><Viewbox><TextBlock Text="♫" Foreground="#FFA43A" FontSize="43"/></Viewbox></Border>
</StackPanel>
