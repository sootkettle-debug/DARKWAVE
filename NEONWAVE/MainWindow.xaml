 <TextBlock Text="+" FontFamily="pack://application:,,,/Fonts/#Pirata One" FontSize="58" FontWeight="Normal" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.10" Margin="0,2,0,0">
