<Window x:Class="NEONWAVE.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Compact Dark" Width="756" Height="674" MinWidth="740" MinHeight="590"
 Background="#080A0C" Foreground="#FF9B2D" WindowStartupLocation="CenterScreen"
 AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" KeyDown="Window_KeyDown">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#FF8A00"/>
  <Color x:Key="AccentColor">#FF8A00</Color>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FF9B2D"/>
   <Setter Property="Background" Value="#1E2428"/>
   <Setter Property="BorderBrush" Value="#536066"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Padding" Value="8,4"/>
   <Setter Property="Margin" Value="2"/>
   <Setter Property="Height" Value="29"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Face" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
      <GradientStop Color="#343C40" Offset="0"/>
      <GradientStop Color="#1B2226" Offset="0.45"/>
      <GradientStop Color="#0E1418" Offset="1"/>
     </LinearGradientBrush></Border.Background>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="#FF8A00"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value="0.7"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox">
   <Setter Property="Background" Value="#0B1013"/>
   <Setter Property="Foreground" Value="#FF9924"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="Foreground" Value="#FF9924"/>
   <Setter Property="Padding" Value="4,3"/>
   <Setter Property="Margin" Value="1"/>
   <Style.Triggers>
    <Trigger Property="IsSelected" Value="True">
     <Setter Property="Background" Value="#34312C"/><Setter Property="Foreground" Value="#FFB258"/>
    </Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#1F292E"/></Trigger>
   </Style.Triggers>
  </Style>
  <Style TargetType="Slider">
   <Setter Property="Foreground" Value="#FF8A00"/>
   <Setter Property="Background" Value="#151B1F"/>
  </Style>
 </Window.Resources>
 <Border Background="#11171B" BorderBrush="#4C5A60" BorderThickness="1" CornerRadius="12" Margin="7" Padding="7">
 <Grid>
  <Grid.RowDefinitions>
   <RowDefinition Height="Auto"/>
   <RowDefinition Height="Auto"/>
   <RowDefinition x:Name="LibraryRow" Height="*"/>
  </Grid.RowDefinitions>
  <!-- Compact display and progress area -->
  <Border Grid.Row="0" Background="#11191D" BorderBrush="#3D5057" BorderThickness="1" CornerRadius="9" Padding="10,7" Margin="0,0,0,6">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="65"/><RowDefinition Height="30"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="100"/><ColumnDefinition Width="*"/><ColumnDefinition Width="82"/></Grid.ColumnDefinitions>
     <Grid Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center">
      <Border x:Name="LogoGlow" Width="50" Height="50" CornerRadius="25" Background="#10171C" BorderBrush="#FF8A00" BorderThickness="2"/>
      <TextBlock Text="◉" Foreground="#FF8A00" FontSize="27" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Grid>
     <StackPanel Grid.Column="1" VerticalAlignment="Center">
      <TextBlock Text="DARKWAVE +" FontFamily="pack://application:,,,/Fonts/#Pirata One" Foreground="#4F555A" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="TrackInfo" Text="COMPACT DARK • READY" Foreground="#FF8A00" FontSize="9" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </StackPanel>
     <Border Grid.Column="2" Background="#070D10" BorderBrush="#5A6C72" BorderThickness="1" CornerRadius="5" Margin="7,2" Padding="3">
      <Viewbox><TextBlock Text="♫" Foreground="#D3E3D9" FontSize="40" HorizontalAlignment="Center"/></Viewbox>
     </Border>
    </Grid>
    <Border Grid.Row="1" Background="#070B0E" BorderBrush="#37454C" BorderThickness="1" CornerRadius="5" Padding="6,2" Margin="3,0">
     <TextBlock x:Name="TrackTitle" Text="No track loaded" Foreground="#FF9B22" FontSize="15" FontWeight="SemiBold" FontFamily="Consolas" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <Grid Grid.Row="2" Margin="0,4,0,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="39"/><ColumnDefinition Width="*"/><ColumnDefinition Width="39"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="#A6AEB0" FontSize="10" VerticalAlignment="Center"/>
     <Slider x:Name="SeekSlider" Grid.Column="1" Minimum="0" Maximum="100" Margin="3,0" VerticalAlignment="Center" ValueChanged="SeekSlider_ValueChanged" PreviewMouseLeftButtonDown="SeekSlider_MouseDown" PreviewMouseLeftButtonUp="SeekSlider_MouseUp"/>
     <TextBlock x:Name="DurationText" Grid.Column="2" Text="0:00" Foreground="#A6AEB0" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
   </Grid>
  </Border>
  <!-- Compact transport and audio controls -->
  <Border x:Name="PlaybackControlsPanel" Grid.Row="1" Background="#121B20" BorderBrush="#42545D" BorderThickness="1" CornerRadius="9" Padding="8,7" Margin="0,0,0,7">
   <Grid Height="100">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="155"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
    <Grid Grid.Column="0">
     <Grid.RowDefinitions><RowDefinition Height="22"/><RowDefinition Height="35"/><RowDefinition Height="38"/></Grid.RowDefinitions>
     <TextBlock x:Name="ReadyStatusText" Text="DARKWAVE • PLAYBACK" Foreground="#AEB3B4" FontSize="10" VerticalAlignment="Center"/>
     <TextBlock Grid.Row="1" Text="◉    L      LM      M      HM      H" Foreground="#FF8A00" FontSize="12" VerticalAlignment="Center" ToolTip="Five-band EQ integration is pending; this preview retains original playback functionality."/>
     <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Content="◀◀" Width="72" Click="Previous_Click" ToolTip="Previous track"/>
      <Button x:Name="PlayButton" Content="▶" Width="72" Click="Play_Click" ToolTip="Play/pause"/>
      <Button Content="■" Width="72" Click="Stop_Click" ToolTip="Stop"/>
      <Button Content="▶▶" Width="72" Click="Next_Click" ToolTip="Next track"/>
     </StackPanel>
    </Grid>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="6,0">
     <TextBlock Text="LEVEL CAUTION" Foreground="#9CA9AB" HorizontalAlignment="Center" FontSize="10"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,9">
      <Button Click="AccentPurple_Click" Width="24" Height="24" Padding="0" ToolTip="Purple accent"><TextBlock Text="●" Foreground="#A65BE0"/></Button>
      <Button Click="AccentGreen_Click" Width="24" Height="24" Padding="0" ToolTip="Green accent"><TextBlock Text="●" Foreground="#00B84C"/></Button>
      <Button Click="AccentOrange_Click" Width="24" Height="24" Padding="0" ToolTip="Orange accent"><TextBlock Text="●" Foreground="#FF8A00"/></Button>
      <Button Click="AccentBlue_Click" Width="24" Height="24" Padding="0" ToolTip="Blue accent"><TextBlock Text="●" Foreground="#268BFF"/></Button>
     </StackPanel>
    </StackPanel>
    <Grid Grid.Column="2" Margin="9,0,0,0">
     <Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="26"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="VOLUME" HorizontalAlignment="Center" Foreground="#FF8A00" FontWeight="Bold" FontSize="11"/>
     <TextBlock x:Name="VolumeText" Grid.Row="1" Text="80%" HorizontalAlignment="Center" FontSize="12" Foreground="#FF9B22"/>
     <Slider x:Name="VolumeSlider" Grid.Row="2" Minimum="0" Maximum="100" Value="80" Margin="9,0" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged"/>
    </Grid>
   </Grid>
  </Border>
  <!-- Three-column library and action ribbon -->
  <Border x:Name="MusicLibraryPanel" Grid.Row="2" Background="#12191D" BorderBrush="#42525A" BorderThickness="1" CornerRadius="9" Padding="9">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid x:Name="LibraryHeader" Margin="0,0,0,7">
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <StackPanel x:Name="LibraryActions" Grid.Column="0" Orientation="Horizontal">
      <TextBlock x:Name="LibraryTitle" Text="LIBRARY" Visibility="Collapsed"/>
      <Button Content="ADD FOLDER" Click="AddFolder_Click" Width="88"/>
      <Button Content="REMOVE" Click="Remove_Click" Width="68"/>
     </StackPanel>
     <StackPanel x:Name="LibraryPlaylistActions" Grid.Column="1" Orientation="Horizontal" Margin="4,0,0,0">
      <Button Content="LOAD PL" Click="LoadPlaylist_Click" Width="75"/>
      <Button Content="SAVE PL" Click="SavePlaylist_Click" Width="75"/>
      <Button Content="REMOVE PL" Click="RemovePlaylist_Click" Width="85" ToolTip="Remove selected playlist"/>
     </StackPanel>
     <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <StackPanel x:Name="LibraryTrackActions" Orientation="Horizontal">
       <Button Content="ADD TRACK" Click="Add_Click" Width="87"/>
       <Button Content="REMOVE TRACK" Click="RemoveTrack_Click" Width="103"/>
      </StackPanel>
      <TextBlock x:Name="LibraryToggleText" Text="CLOSE" Visibility="Collapsed"/>
      <Button x:Name="LibraryToggleButton" Content="−" Click="ToggleMusicLibrary_Click" Width="28" ToolTip="Close/open library"/>
     </StackPanel>
    </Grid>
    <Grid x:Name="LibraryContent" Grid.Row="1">
     <Grid.ColumnDefinitions><ColumnDefinition Width="0.85*" MinWidth="110"/><ColumnDefinition Width="5"/><ColumnDefinition Width="0.85*" MinWidth="110"/><ColumnDefinition Width="5"/><ColumnDefinition Width="1.52*" MinWidth="200"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Background="#0B1013" BorderBrush="#35434A" BorderThickness="1" CornerRadius="5" Padding="5">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="FOLDERS" Foreground="#FF8A00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
       <ListBox x:Name="FolderList" SelectionChanged="FolderList_SelectionChanged" DisplayMemberPath="Name"/>
      </DockPanel>
     </Border>
     <GridSplitter Grid.Column="1" Width="5" Background="#3A2729" HorizontalAlignment="Stretch"/>
     <Border Grid.Column="2" Background="#0B1013" BorderBrush="#35434A" BorderThickness="1" CornerRadius="5" Padding="5">
      <DockPanel>
       <TextBlock DockPanel.Dock="Top" Text="PLAYLISTS" Foreground="#FF8A00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
       <ListBox x:Name="PlaylistList" SelectionChanged="PlaylistList_SelectionChanged" DisplayMemberPath="Name"/>
      </DockPanel>
     </Border>
     <GridSplitter Grid.Column="3" Width="5" Background="#3A2729" HorizontalAlignment="Stretch"/>
     <Border Grid.Column="4" Background="#0B1013" BorderBrush="#35434A" BorderThickness="1" CornerRadius="5" Padding="5">
      <DockPanel>
       <TextBlock x:Name="FolderContentsTitle" DockPanel.Dock="Top" Text="TRACKS • MUSIC" Foreground="#FF8A00" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,8"/>
       <ListBox x:Name="FolderTracks" SelectionMode="Extended" MouseDoubleClick="FolderTracks_MouseDoubleClick">
        <ListBox.ItemTemplate><DataTemplate>
         <StackPanel Orientation="Horizontal">
          <TextBlock Text="{Binding PlayingMarker}" Foreground="#FF8A00" Margin="0,0,5,0"/>
          <TextBlock Text="{Binding DisplayName}" Foreground="#FF9B22" TextTrimming="CharacterEllipsis"/>
         </StackPanel>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>
     </Border>
    </Grid>
    <TextBlock Grid.Row="2" x:Name="QueueCount" Text="0 TRACKS • 0 FOLDERS" Foreground="#FF8A00" FontWeight="SemiBold" FontSize="10" Margin="2,7,0,0"/>
   </Grid>
  </Border>
 </Grid>
 </Border>
</Window>